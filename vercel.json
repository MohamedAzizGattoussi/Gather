{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 300 },
    "api/import.py": {
      "maxDuration": 300,
      "includeFiles": "server/**/*.py",
      "excludeFiles": "{node_modules/**,dist/**,docs/**,scripts/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/media/:path*", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/((?!api/|media/|assets/|healthz).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
